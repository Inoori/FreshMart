# 默认：所有文本文件用 LF 存储，检出时不转换
* text=auto eol=lf

# C# / .NET 源码
*.cs        text eol=lf
*.csproj    text eol=lf
*.props     text eol=lf
*.targets   text eol=lf
*.sln       text eol=lf
*.slnx      text eol=lf
*.json      text eol=lf
*.xml       text eol=lf
*.config    text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.http      text eol=lf
*.sh        text eol=lf

# Windows 专用脚本保留 CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# 二进制文件不做转换
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.gz        binary
*.tar       binary
*.dll       binary
*.exe       binary
*.so        binary
*.dylib     binary
*.pfx       binary
*.p12       binary
*.snk       binary

# 锁文件
packages.lock.json text eol=lf

# Dockerfile
Dockerfile*  text eol=lf

# 明确标记为二进制（避免 Git 尝试 diff）
*.gif       binary
